<?xml version="1.0" encoding="utf-8"?>
<!-- CarView añade la eelevacion y esquinas redondeadas tipicas de una tarjeta de producto -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardBackgroundColor="#111111"
    app:cardCornerRadius="12dp"
    app:cardMaxElevation="8dp"
    app:strokeColor="#006e09"
    app:strokeWidth="2dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!--Imagen del producto con fondo neutro -->
        <ImageView
            android:id="@+id/ivProducto"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="#000000"
            android:scaleType="fitCenter" />

        <!-- Nombre del producto con estilo Orbitron sugerido -->
        <TextView
            android:id="@+id/tvNombreProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nombre del Producto"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Stock del producto -->
        <TextView
            android:id="@+id/tvStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Stock: 0"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <!--Precio con el color neon caracteristico -->
        <TextView
            android:id="@+id/tvPrecioProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0.00"
            android:textColor="#00ffcc"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
